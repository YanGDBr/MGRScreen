<Window x:Class="MGRScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGRScreen" Height="800" Width="540"
        MinHeight="520" MinWidth="440"
        Background="{StaticResource BgBrush}"
        Icon="Assets/mgrscreen.png"
        WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,18,28,24">

                <!-- Cabeçalho: marca à esquerda, configurações à direita -->
                <Grid Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/mgrscreen.png" Width="44" Height="44" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MGRScreen" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Uma sala onde todo mundo compartilha a tela"
                                       Style="{StaticResource CaptionTextStyle}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="&#xE713;" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="Configurações" Click="OnSettingsClick"/>
                </Grid>

                <!-- Versão nova disponível -->
                <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12"
                        Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Baixar" Tag="&#xE896;" Padding="12,6" FontSize="12"
                                Click="OnUpdateClick"/>
                    </Grid>
                </Border>

                <!-- Quem sou eu -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse x:Name="AvatarCircle" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="AvatarInitial" Text="A" Foreground="White" FontSize="17"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Seu nickname" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox x:Name="NicknameBox" TextChanged="OnNicknameChanged" MaxLength="32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="LastRoomButton" Visibility="Collapsed"
                        Style="{StaticResource ChoiceCardButtonStyle}" Margin="0,0,0,12"
                        Click="OnLastRoomClick">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="LastRoomText" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LastRoomAddressText" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- Criar -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CRIAR UMA SALA" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Você vira o anfitrião. Seus amigos vão ver a sua sala aparecer na lista deles."
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <PasswordBox x:Name="RoomPasswordBox" MaxLength="64" FontSize="13" Padding="10,8"
                                             Background="{StaticResource Surface2Brush}"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush2}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"
                                             PasswordChanged="OnRoomPasswordChanged"
                                             ToolTip="Deixe vazio pra sala ficar aberta a quem estiver nas suas redes"/>
                                <TextBlock x:Name="RoomPasswordHint" Text="Senha (opcional)" IsHitTestVisible="False"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                           VerticalAlignment="Center" Margin="13,0,0,0"/>
                            </Grid>
                            <Button x:Name="CreateRoomButton" Grid.Column="1" Content="Criar sala" Tag="&#xE710;"
                                    Click="OnCreateRoomClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Encontradas -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="SALAS ENCONTRADAS" Style="{StaticResource SectionHeaderTextStyle}"/>
                                <TextBlock x:Name="ScanStatusText" Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,3,0,0" Text="Procurando..."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DiagnoseButton" Content="&#xE9CE;" Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Por que a sala não aparece?" Click="OnDiagnoseClick"/>
                                <Button x:Name="RefreshButton" Content="&#xE72C;" Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Procurar de novo" Click="OnRefreshClick"/>
                            </StackPanel>
                        </Grid>

                        <!-- Altura limitada: com muita gente conectada por várias redes a lista
                             cresceria e empurraria o "entrar por IP" pra fora da tela. -->
                        <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SessionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChoiceCardButtonStyle}" Margin="0,0,0,8"
                                                Tag="{Binding}" Click="OnJoinDiscoveredClick">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="Lock" Grid.Column="0" Text="&#xE72E;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                                           Visibility="Collapsed" ToolTip="Sala com senha"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding HostNickname}" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0">
                                                        <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=" · "/><Run
                                                            Text="{Binding ParticipantCount, Mode=OneWay}"/><Run Text=" na sala"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="2" Style="{StaticResource NetworkChipStyle}">
                                                    <TextBlock Text="{Binding NetworkLabel}"
                                                               Style="{StaticResource NetworkChipTextStyle}"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding RequiresPassword}" Value="True">
                                                <Setter TargetName="Lock" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="NoSessionsText" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="Nenhuma sala por aqui. Peça pro seu amigo criar uma — ou, se ele estiver fora da sua rede, use o IP dele logo abaixo."/>
                    </StackPanel>
                </Border>

                <!-- Por IP -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="ENTRAR POR IP OU LINK" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock Text="Só precisa disso quando a sala não aparece na lista acima. Aceita o IP, o nome da máquina ou um link mgrscreen:// de convite."
                                   Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HostAddressBox" Grid.Column="0" Margin="0,0,10,0"/>
                            <Button x:Name="JoinRoomButton" Grid.Column="1" Content="Entrar" Tag="&#xE72A;"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="OnJoinByAddressClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Primeiro uso: duas telas curtas explicando como as pessoas se encontram. -->
        <Border x:Name="OnboardingOverlay" Visibility="Collapsed" Background="#E60E1013">
            <Border Style="{StaticResource CardStyle}" MaxWidth="400" VerticalAlignment="Center"
                    Margin="28" Padding="26">
                <StackPanel>
                    <Border Width="60" Height="60" CornerRadius="30" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="OnboardingGlyph" Text="&#xE701;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="26" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="OnboardingTitle" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <TextBlock x:Name="OnboardingBody" Style="{StaticResource SubtitleTextStyle}"
                               Margin="0,10,0,0" LineHeight="20"/>
                    <Grid Margin="0,24,0,0">
                        <TextBlock x:Name="OnboardingStep" Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="OnboardingNextButton" Content="Próximo" HorizontalAlignment="Right"
                                MinWidth="110" Click="OnOnboardingNextClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
