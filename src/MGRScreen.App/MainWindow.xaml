<Window x:Class="MGRScreen.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGRScreen" Height="760" Width="520"
        MinHeight="480" MinWidth="420"
        Background="{StaticResource BgBrush}"
        Icon="Assets/mgrscreen.png"
        WindowStartupLocation="CenterScreen"
        Closed="OnWindowClosed">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="30,24,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Source="Assets/mgrscreen.png" Width="64" Height="64"
                   HorizontalAlignment="Center" Margin="0,0,0,10"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="MGRScreen" Style="{StaticResource LogoTextStyle}" HorizontalAlignment="Center"/>
                <TextBlock Text="Uma sala onde todo mundo pode compartilhar a tela"
                           Style="{StaticResource SubtitleTextStyle}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Seu nickname" Style="{StaticResource LabelTextStyle}"/>
                <TextBox x:Name="NicknameBox"/>
            </StackPanel>

            <Button x:Name="LastRoomButton" Grid.Row="3" Visibility="Collapsed"
                    Style="{StaticResource ChoiceCardButtonStyle}" Margin="0,0,0,12"
                    Click="OnLastRoomClick">
                <StackPanel>
                    <TextBlock x:Name="LastRoomText" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LastRoomAddressText" Style="{StaticResource CaptionTextStyle}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Button>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CRIAR UMA SALA" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Você vira o anfitrião. Seus amigos vão ver a sua sala aparecer na lista deles."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                    <Button x:Name="CreateRoomButton" Content="Criar sala" Click="OnCreateRoomClick"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SALAS ENCONTRADAS" Style="{StaticResource SectionHeaderTextStyle}"/>
                            <TextBlock x:Name="ScanStatusText" Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,3,0,0" Text="Procurando..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DiagnoseButton" Content="Por que não aparece?"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11"
                                    Margin="0,0,8,0" Click="OnDiagnoseClick"/>
                            <Button x:Name="RefreshButton" Content="Procurar de novo"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" FontSize="11"
                                    Click="OnRefreshClick"/>
                        </StackPanel>
                    </Grid>

                    <!-- Altura limitada: com muita gente conectada por várias redes a lista
                         cresceria e empurraria o "entrar por IP" pra fora da tela. -->
                    <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SessionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceCardButtonStyle}" Margin="0,0,0,8"
                                        Tag="{Binding}" Click="OnJoinDiscoveredClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding HostNickname}" FontSize="15" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,3,0,0">
                                                <Run Text="{Binding Address, Mode=OneWay}"/><Run Text=" · "/><Run
                                                    Text="{Binding ParticipantCount, Mode=OneWay}"/><Run Text=" na sala"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="1" Style="{StaticResource NetworkChipStyle}">
                                            <TextBlock Text="{Binding NetworkLabel}"
                                                       Style="{StaticResource NetworkChipTextStyle}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="NoSessionsText" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Text="Nenhuma sala por aqui. Peça pro seu amigo criar uma — ou, se ele estiver fora da sua rede, use o IP dele logo abaixo."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ENTRAR POR IP" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,6"/>
                    <TextBlock Text="Só precisa disso quando a sala não aparece na lista acima — por exemplo se o seu amigo estiver fora da sua rede, com as portas liberadas no roteador."
                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HostAddressBox" Grid.Column="0" Margin="0,0,10,0"/>
                        <Button x:Name="JoinRoomButton" Grid.Column="1" Content="Entrar"
                                Style="{StaticResource SecondaryButtonStyle}" Click="OnJoinByAddressClick"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Grid.Row="7" Style="{StaticResource CaptionTextStyle}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,18,0,0"
                       TextWrapping="Wrap"/>
        </Grid>
    </ScrollViewer>
</Window>
