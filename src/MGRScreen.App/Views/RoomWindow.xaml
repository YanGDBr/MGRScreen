<Window x:Class="MGRScreen.App.Views.RoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MGRScreen — Sala" Height="780" Width="1240"
        MinHeight="520" MinWidth="1000"
        Background="{StaticResource BgBrush}"
        Icon="../Assets/mgrscreen.png"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <!-- MinWidth na coluna dos participantes: sem piso, quando os outros blocos
                     ocupavam a largura toda ela era espremida a ~0 px, o texto quebrava uma letra
                     por linha e o cabeçalho crescia até cobrir a janela inteira. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="170"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="../Assets/mgrscreen.png" Width="34" Height="34"
                       Margin="0,0,14,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="ENDEREÇO DA SALA" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="RoomAddressText" Text="..." FontFamily="Consolas"
                                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Copiar convite" Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4" FontSize="11" Margin="12,0,0,0"
                                VerticalAlignment="Center" Click="OnCopyRoomInfoClick"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,16,0">
                    <TextBlock x:Name="ParticipantsText" Text="Conectando..." Style="{StaticResource SectionHeaderTextStyle}"/>
                    <ItemsControl x:Name="ParticipantsPanel" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="ConnectionInfoText" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RelayUploadText" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Áudio: dispositivo + medidor de nível (pra dar pra ver se está captando algo) -->
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0" Width="290">
                    <TextBlock Text="ÁUDIO QUE VOU COMPARTILHAR" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <ComboBox x:Name="AudioModeCombo" Margin="0,4,0,6"
                              SelectionChanged="OnAudioModeChanged">
                        <ComboBoxItem Content="Tudo, menos MGRScreen e Discord" IsSelected="True"/>
                        <ComboBoxItem Content="Tudo, menos o MGRScreen (sem eco)"/>
                        <ComboBoxItem Content="Tudo, menos o Discord"/>
                        <ComboBoxItem Content="Apenas um app..."/>
                        <ComboBoxItem Content="Sem áudio"/>
                    </ComboBox>
                    <ComboBox x:Name="AudioAppCombo" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <Border x:Name="AudioLevelTrack" Height="6" CornerRadius="3" Background="{StaticResource Surface2Brush}">
                        <Border x:Name="AudioLevelBar" Width="0" HorizontalAlignment="Left"
                                CornerRadius="3" Background="{StaticResource SuccessBrush}"/>
                    </Border>
                    <ComboBox x:Name="QualityCombo" Margin="0,8,0,0">
                        <ComboBoxItem Content="Qualidade: 1080p 30fps" IsSelected="True"/>
                        <ComboBoxItem Content="Qualidade: 1080p 60fps"/>
                        <ComboBoxItem Content="Qualidade: 720p 60fps"/>
                        <ComboBoxItem Content="Qualidade: 720p 30fps"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Width="132">
                    <TextBlock Text="VOLUME DA SALA" Style="{StaticResource SectionHeaderTextStyle}"/>
                    <Slider x:Name="MasterVolumeSlider" Minimum="0" Maximum="100" Value="100"
                            Margin="0,6,0,0" ValueChanged="OnMasterVolumeChanged"/>
                    <TextBlock x:Name="MasterVolumeText" Text="100%" Style="{StaticResource CaptionTextStyle}"
                               HorizontalAlignment="Right"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Grade de telas compartilhadas -->
        <Grid Grid.Row="1" Margin="16">
            <Border x:Name="ReconnectBanner" Visibility="Collapsed" Panel.ZIndex="10"
                    Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,10"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                <TextBlock x:Name="ReconnectBannerText" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <TextBlock x:Name="EmptyStateText"
                       Text="Ninguém está compartilhando a tela ainda.&#10;Clique em “Compartilhar minha tela” pra começar."
                       Style="{StaticResource CaptionTextStyle}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Os tiles têm tamanho calculado em RelayoutTiles(): antes um único participante
                 esticava pra ocupar a área inteira e ficava desproporcional. -->
            <ScrollViewer x:Name="TilesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MinHeight="{Binding ViewportHeight, ElementName=TilesScroll}">
                    <WrapPanel x:Name="TilesGrid" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Barra de controles: status à esquerda, ações à direita. As ações moravam no
             cabeçalho e disputavam largura com áudio/volume/participantes; aqui embaixo (como
             em Meet/Discord/Teams) cabem folgadas mesmo na largura mínima da janela. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Desabilitado até detectar o encoder (fim do OnLoaded): ligar antes disso
                         cairia no libx264 mesmo com placa de vídeo disponível. -->
                    <Button x:Name="CameraButton" Content="Ligar câmera"
                            Style="{StaticResource SecondaryButtonStyle}" IsEnabled="False"
                            Click="OnCameraClick" Margin="0,0,10,0"/>
                    <Button x:Name="ShareAgainButton" Content="Compartilhar de novo"
                            Style="{StaticResource SecondaryButtonStyle}" Visibility="Collapsed"
                            Click="OnShareAgainClick" Margin="0,0,10,0"/>
                    <Button x:Name="ShareButton" Content="Compartilhar minha tela"
                            Click="OnShareClick" MinWidth="180"/>
                    <Button x:Name="StopShareButton" Content="Parar" Style="{StaticResource DangerButtonStyle}"
                            Click="OnStopShareClick" Visibility="Collapsed" MinWidth="90"/>
                    <Button x:Name="LeaveRoomButton" Content="Sair da sala"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnLeaveRoomClick" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Camada de tela cheia: recebe o tile escolhido por cima de tudo -->
        <Grid x:Name="FullscreenHost" Grid.Row="0" Grid.RowSpan="3" Background="Black"
              Visibility="Collapsed"/>
        <!-- Qual câmera ligar, quando a máquina tem mais de uma. -->
        <Popup x:Name="CameraPickerPopup" PlacementTarget="{Binding ElementName=CameraButton}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               VerticalOffset="-6">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="10" Padding="10" MinWidth="240">
                <StackPanel>
                    <TextBlock Text="QUAL CÂMERA?" Style="{StaticResource SectionHeaderTextStyle}"
                               Margin="4,2,4,8"/>
                    <StackPanel x:Name="CameraPickerList"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Volume de uma tela só. Abre com botão direito em cima da tela da pessoa. -->
        <Popup x:Name="VolumePopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="10" Padding="14" Width="248">
                <StackPanel>
                    <TextBlock x:Name="VolumePopupTitle" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="VolumeSlider" Grid.Column="0" Minimum="0" Maximum="200" Value="100"
                                TickFrequency="100" IsSnapToTickEnabled="False"
                                VerticalAlignment="Center" ValueChanged="OnTileVolumeChanged"/>
                        <TextBlock x:Name="VolumeValueText" Grid.Column="1" Text="100%" Width="44"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}"/>
                    </Grid>

                    <TextBlock Text="Acima de 100% pode distorcer se o áudio da pessoa já estiver alto."
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Button x:Name="VolumePopupMuteButton" Content="Silenciar" Margin="0,12,0,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="OnVolumePopupMuteClick"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
